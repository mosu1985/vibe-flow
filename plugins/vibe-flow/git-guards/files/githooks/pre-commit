#!/usr/bin/env sh
# CANONICAL pre-commit. Lives in the repository and is installed by
# scripts/install-git-guards.sh into $GIT_COMMON_DIR/monitorex-hooks —
# outside any checkout, so switching branches cannot swap out the guard.
#
# POLICY: a regular `git commit` is forbidden in the SHARED working tree — the
# index there is shared, and while tests run a neighbor manages to `git add`
# something that ends up in your commit (git has no pre-add hook). A linked
# worktree has its own index — allowed there.
set -e

# 🔴 Compare the RAW output of both commands, not normalized paths:
# on macOS /var/folders is a symlink to /private/var, and `cd … && pwd` gives a
# different string than --absolute-git-dir. Because of that the check silently
# never fired. In the main working tree both print ".git"; in a linked worktree
# --git-dir points to .git/worktrees/<name> — enough to tell them apart.
GITDIR_RAW=$(git rev-parse --git-dir)
COMMON_RAW=$(git rev-parse --git-common-dir)
COMMON=$(cd "$COMMON_RAW" && pwd -P)

# Maintenance operations (merge/rebase/cherry-pick) run under a commit lock taken in advance.
for f in MERGE_HEAD REBASE_HEAD CHERRY_PICK_HEAD; do
    if [ -f "$(git rev-parse --git-path $f)" ]; then
        if [ -d "$COMMON/monitorex-locks/commit" ]; then exit 0; fi
        echo ""
        echo "🔴 Maintenance operation ($f) requires the lock."
        echo "   Take it: scripts/git-lock.sh status  →  then retry"
        echo ""
        exit 1
    fi
done

if [ "$GITDIR_RAW" = "$COMMON_RAW" ]; then   # we are in the MAIN working tree
    if [ "${MONITOREX_SAFE_COMMIT:-0}" = "1" ]; then exit 0; fi

    # One-off owner mark: lives 15 minutes, tied to a target, CONSUMED right here
    # after use. There is deliberately no environment variable — an agent would
    # set it without a second thought, while a human sets the mark via a command that asks.
    CONFIRM="$COMMON/monitorex-locks/CONFIRM"
    if [ -f "$CONFIRM" ]; then
        age=$(( $(date +%s) - $(stat -f %m "$CONFIRM") ))
        if [ "$age" -lt 900 ] && grep -q '^target=commit$' "$CONFIRM"; then
            rm -f "$CONFIRM"
            echo "⚠️  regular commit allowed by a one-off mark (now consumed)"
            npm test
            exit $?
        fi
    fi
    echo ""
    echo "🔴 A regular git commit is forbidden in the shared working tree."
    echo ""
    echo "   The index here is shared: while a commit is in progress, a parallel session"
    echo "   manages to git add — and its files end up in your commit. It has happened"
    echo "   (2026-08-06: 7 foreign files in a commit about filter layout)."
    echo ""
    echo "   Commit like this:"
    echo "     scripts/git-safe-commit.sh --message-file <file> -- <paths>"
    echo ""
    echo "   Need partial staging (git add -p)? Do it in a worktree:"
    echo "     scripts/wt-new.sh <name>"
    echo ""
    echo "   One-off deliberate bypass (by a human, with confirmation):"
    echo "     scripts/git-confirm.sh commit"
    echo ""
    exit 1
fi

npm test
