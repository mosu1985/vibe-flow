#!/usr/bin/env sh
# CANONICAL pre-push. Lives in the repository and is installed into
# $GIT_COMMON_DIR/monitorex-hooks (outside any checkout) — otherwise switching
# the main working tree to an old revision hands git an old version of this
# file, and its own checks simply vanish.
#
# 🔴 The ONLY automatic type check in the project (see below), plus the
# parallel-session barriers. Order matters: cheap rejections come before tsc.

set -e

COMMON=$(git rev-parse --git-common-dir)
case "$COMMON" in /*) ;; *) COMMON="$(cd "$COMMON" && pwd -P)" ;; esac
ZERO="0000000000000000000000000000000000000000"

# ── Project configuration ────────────────────────────────────────────────────
# The hook lives OUTSIDE the working tree and serves any stack, so everything
# project-specific comes from .gitguards.conf at the tree root. No file — the
# defaults below apply: the parallel-session barriers always work, and the type
# check is silently skipped (nothing to check with).
GG_PROTECTED="main"
GG_TYPECHECK_CMD=""
GG_DEV_READY_GLOBS=""
GG_REQUIRE_DEV_READY=0
GG_DEV_CMD=""
GG_RELEASE_GATE=0
GG_RELEASE_GATE_SKIP="*.md"
GG_TOP=$(git rev-parse --show-toplevel 2>/dev/null || echo .)
if [ -f "$GG_TOP/.gitguards.conf" ]; then . "$GG_TOP/.gitguards.conf"; fi

# The release-gate is enabled by repository POLICY, not by the branch: a tree from
# an old base does not know about the new flag in its .gitguards.conf and would skip
# the gate. So both the protected branch's flag on the remote and the main working
# tree's flag count — enabled anywhere means enabled (fail-closed). The remote branch
# is the primary source: the main working tree's checkout can be hundreds of commits behind.
gate_on() { grep -qE '^GG_RELEASE_GATE="?1"?' 2>/dev/null; }
if [ "$GG_RELEASE_GATE" != "1" ]; then
    if git show "refs/remotes/${1:-origin}/$GG_PROTECTED:.gitguards.conf" 2>/dev/null | gate_on; then
        GG_RELEASE_GATE=1
    elif [ -f "$(dirname "$COMMON")/.gitguards.conf" ] \
         && gate_on < "$(dirname "$COMMON")/.gitguards.conf"; then
        GG_RELEASE_GATE=1
    fi
fi
# The "no review needed" masks are policy too, not a branch setting: a branch that
# set GG_RELEASE_GATE_SKIP="*" for itself would ship without review. They come from
# the protected branch's config on the remote, or, if absent, from the main working tree.
skip_policy() {
    grep -E '^GG_RELEASE_GATE_SKIP=' | tail -1 \
        | sed -e 's/^GG_RELEASE_GATE_SKIP=//' -e "s/^[\"']//" -e "s/[\"']\$//"
}
GG_RELEASE_GATE_SKIP="*.md"
if gpol=$(git show "refs/remotes/${1:-origin}/$GG_PROTECTED:.gitguards.conf" 2>/dev/null); then
    if printf '%s\n' "$gpol" | grep -q '^GG_RELEASE_GATE_SKIP='; then
        GG_RELEASE_GATE_SKIP=$(printf '%s\n' "$gpol" | skip_policy)
    fi
elif [ -f "$(dirname "$COMMON")/.gitguards.conf" ] \
     && grep -q '^GG_RELEASE_GATE_SKIP=' "$(dirname "$COMMON")/.gitguards.conf"; then
    GG_RELEASE_GATE_SKIP=$(skip_policy < "$(dirname "$COMMON")/.gitguards.conf")
fi
GATE_DIR="$COMMON/monitorex-locks/release-gate"

PROTECTED="$GG_PROTECTED"
ALLOW="$COMMON/monitorex-locks/push-allow"
# Session identity. Empty means there is no way to prove authorship, and every
# new commit will have to be confirmed via the allowlist. For a human this is a
# one-time setup: export MONITOREX_ACTOR="alice".
ACTOR="${CLAUDE_CODE_SESSION_ID:-${MONITOREX_ACTOR:-}}"

# ─── 0. The hooks must be canonical ─────────────────────────────────────────
# `npm install` runs `prepare: husky`, which restores a relative core.hooksPath —
# then a worktree from an old base would bypass the guard.
# Compare RESOLVED paths, not strings: on macOS /var/folders is a symlink to
# /private/var, and the same directory yields two different strings.
HP=$(git config core.hooksPath || echo "")
HP_R=""
[ -n "$HP" ] && HP_R=$(cd "$HP" 2>/dev/null && pwd -P || echo "")
EXPECT="$COMMON/monitorex-hooks"
EXPECT_R=$(cd "$EXPECT" 2>/dev/null && pwd -P || echo "$EXPECT")
if [ "$HP_R" != "$EXPECT_R" ]; then
     echo ""
     echo "🔴 core.hooksPath is not canonical: '${HP:-not set}'"
     echo "   Expected: $EXPECT"
     echo "   Looks like npm install restored the husky path. To fix:"
     echo "     bash scripts/install-git-guards.sh"
     echo ""
     exit 1
fi

# ─── 1. stdin is read ONCE ──────────────────────────────────────────────────
# A second loop would get EOF, pushed_any would stay 0 — and the type check
# would silently never run.
REFS=$(cat)
[ -n "$REFS" ] || exit 0

REMOTE_NAME="$1"

pushing_head=0
pushed_any=0

# ─── 2. Barriers for each pushed ref ────────────────────────────────────────
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    pushed_any=1

    # --- branch deletion ---
    if [ "$local_sha" = "$ZERO" ]; then
        case "$remote_ref" in
          refs/heads/"$PROTECTED")
            echo ""; echo "🔴 Deleting protected branch $PROTECTED is forbidden locally."
            echo "   We do not rely on GitHub settings — we cannot see them."; echo ""
            exit 1 ;;
        esac
        continue
    fi

    # --- tags ---
    case "$remote_ref" in
      refs/tags/*)
        if [ "$remote_sha" != "$ZERO" ]; then
            echo ""; echo "🔴 Overwriting tag $remote_ref is destructive — rejected."; echo ""
            exit 1
        fi
        continue ;;
      refs/heads/*) ;;
      *)
        echo ""; echo "🔴 Push to $remote_ref is not supported by the guard (fail-closed)."; echo ""
        exit 1 ;;
    esac

    # --- branch update: fast-forward is mandatory ---
    if [ "$remote_sha" != "$ZERO" ]; then
        if ! git cat-file -e "$remote_sha" 2>/dev/null; then
            echo ""; echo "🔴 Object $remote_sha is not available locally — nothing to compare with."
            echo "   Run git fetch and retry."; echo ""
            exit 1
        fi
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
            echo ""; echo "🔴 Not a fast-forward: $remote_ref would move backwards."
            echo "   That erases other people's commits. Rebase onto the fresh branch."; echo ""
            exit 1
        fi
    fi

    # --- ownership: whose commit is shipping ---
    # Incident of 02.09.2026: a push carried a neighboring session's commit to the
    # remote that nobody had approved. Earlier `2a2280f1`, which was awaiting a deploy
    # decision, shipped the same way. Look ONLY at commits that are not yet on any
    # remote — old history does not get here and breaks nothing.
    if [ "$remote_sha" = "$ZERO" ]; then
        new_commits=$(git rev-list "$local_sha" --not --remotes="$REMOTE_NAME" 2>/dev/null)
    else
        # Not "remote_sha..local_sha": that pulled in commits already present in
        # OTHER remote branches (main's merge commits after fast-forwarding the
        # branch), and the hook called them someone else's work (25.10.2026, PR #227).
        new_commits=$(git rev-list "$local_sha" --not "$remote_sha" --remotes="$REMOTE_NAME" 2>/dev/null)
    fi

    foreign=""
    for sha in $new_commits; do
        owner=$(git log -1 --format='%(trailers:key=Session-Id,valueonly)' "$sha" | tr -d '\n')
        [ -n "$ACTOR" ] && [ "$owner" = "$ACTOR" ] && continue          # our own
        if [ -f "$ALLOW" ] && grep -qx "$sha" "$ALLOW" 2>/dev/null; then
            continue                                                    # explicitly allowed
        fi
        foreign="$foreign$sha
"
    done

    if [ -n "$foreign" ]; then
        echo ""
        echo "🔴 The push contains commits that this session did not create:"
        echo ""
        printf '%s' "$foreign" | while read -r sha; do
            [ -n "$sha" ] || continue
            printf '     %s  %s\n' "$(git rev-parse --short "$sha")" "$(git log -1 --format=%s "$sha")"
            printf '       author: %s   Session-Id: %s\n' \
                "$(git log -1 --format='%an' "$sha")" \
                "$(git log -1 --format='%(trailers:key=Session-Id,valueonly)' "$sha" | tr -d '\n' | sed 's/^$/none/')"
        done
        echo ""
        echo "   Pushing someone else's work under your name is allowed only deliberately:"
        echo "     scripts/git-allow-push.sh add <sha…>"
        echo ""
        [ -z "$ACTOR" ] && echo "   (session identity is not set — set MONITOREX_ACTOR, otherwise even"
        [ -z "$ACTOR" ] && echo "    your own commits do not count as yours)"
        [ -z "$ACTOR" ] && echo ""
        exit 1
    fi

    # --- release-gate: an Opus reviewer has read the branch diff ---
    # Reviewers look at the plan, but bugs live in the code. Code from Sonnet/Haiku
    # subagents used to be looked at by nobody after implementation. The verdict is set
    # by the release-gate agent (scripts/release-gate.sh pass) and tied to the commit's
    # TREE: a content change revokes it, a rebuild without changes does not.
    if [ "$GG_RELEASE_GATE" = "1" ]; then
        bref="refs/remotes/$REMOTE_NAME/$PROTECTED"
        if ! git rev-parse --verify -q "$bref" >/dev/null 2>&1; then
            echo ""
            echo "🔴 release-gate: no $bref — nothing to compare with. Run git fetch."
            echo ""
            exit 1
        fi
        if ! gbase=$(git merge-base "$bref" "$local_sha" 2>/dev/null); then
            echo ""
            echo "🔴 release-gate: $(git rev-parse --short "$local_sha") has no common history with $bref — cannot build a diff."
            echo ""
            exit 1
        fi
        # The mask logic matches release-gate.sh — otherwise the script would say
        # "no review needed" while the hook refuses. --no-renames: otherwise renaming
        # code to *.md would look like "docs only".
        need=$(git -c core.quotePath=false diff --no-renames --name-only "$gbase" "$local_sha" | while IFS= read -r f; do
            [ -n "$f" ] || continue
            skip=0
            set -f
            for pat in $GG_RELEASE_GATE_SKIP; do
                case "$f" in ($pat) skip=1 ;; esac
            done
            set +f
            [ "$skip" = 1 ] || printf '%s\n' "$f"
        done)
        gtree=$(git rev-parse "$local_sha^{tree}")
        # A verdict counts only if it is real: a verdict= line and a head= whose
        # tree matches the one being pushed. An empty file created bypassing the
        # script is not a verdict.
        gvalid=0
        if [ -f "$GATE_DIR/$gtree" ] \
           && grep -qE '^verdict=(pass|override)$' "$GATE_DIR/$gtree"; then
            ghead=$(sed -n 's/^head=//p' "$GATE_DIR/$gtree" | head -1)
            if [ -n "$ghead" ] \
               && [ "$(git rev-parse -q --verify "$ghead^{tree}" 2>/dev/null)" = "$gtree" ]; then
                gvalid=1
            fi
        fi
        if [ -n "$need" ] && [ "$gvalid" = 0 ]; then
            echo ""
            echo "🔴 release-gate: the diff of $(git rev-parse --short "$local_sha") has not passed final review."
            echo ""
            echo "   Code moves on only after an Opus reviewer's verdict. Run the"
            echo "   release-gate agent on this tree — it will read the diff from $PROTECTED"
            echo "   and on ✅ record the verdict (scripts/release-gate.sh status — to check)."
            echo ""
            echo "   The verdict is tied to the content: after any change, review again."
            echo "   Bypass is for a human only: scripts/release-gate.sh override"
            if [ ! -f "$GG_TOP/scripts/release-gate.sh" ]; then
                # A tree from a base older than the gate: the agent has no way to record a verdict.
                echo ""
                echo "   ⚠️ This tree has no scripts/release-gate.sh — it was created from a base"
                echo "   older than the gate. First merge the fresh $PROTECTED: git merge $bref"
            fi
            echo ""
            exit 1
        fi
        if [ -n "$need" ]; then
            echo "✅ release-gate: $(sed -n 's/^verdict=//p' "$GATE_DIR/$gtree") for tree $(echo "$gtree" | cut -c1-8)"
        fi
    fi

    # --- content: deletion of other people's files ---
    case "$remote_ref" in
      refs/heads/"$PROTECTED")
        rref="refs/remotes/$REMOTE_NAME/$PROTECTED"
        if git rev-parse --verify -q "$rref" >/dev/null 2>&1; then
            dels=$(git diff --diff-filter=D --name-only "$rref" "$local_sha" -- 2>/dev/null)
            if [ -n "$dels" ]; then
                # 🔴 This barrier MUST have a deliberate bypass, like all the others.
                # Until 10.09.2026 it had none: the advice "rebase" does not help when
                # the base is fresh and the deletion is intentional, and the only way
                # out was --no-verify — that is, ALSO dropping the type check and the
                # authorship check. A bypass that kills every barrier at once trains
                # people to use it for any reason.
                # A human sets the mark by name (scripts/git-allow-delete.sh); it lives
                # 15 minutes and is consumed here after the first use.
                ALLOWDEL="$COMMON/monitorex-locks/delete-allow"
                fresh=0
                if [ -f "$ALLOWDEL" ]; then
                    dage=$(( $(date +%s) - $(stat -f %m "$ALLOWDEL" 2>/dev/null || echo 0) ))
                    [ "$dage" -lt 900 ] && fresh=1
                fi
                # Check FILE BY FILE: a mark for two paths must not allow deleting
                # a third one that happened to land in the same commit.
                unapproved=$(printf '%s\n' "$dels" | while IFS= read -r d; do
                    [ -n "$d" ] || continue
                    if [ "$fresh" = "1" ] && grep -qxF -- "$d" "$ALLOWDEL" 2>/dev/null; then
                        :
                    else
                        printf '%s\n' "$d"
                    fi
                done)

                if [ -n "$unapproved" ]; then
                    echo ""
                    echo "🔴 This push DELETES files from $PROTECTED:"
                    echo "$dels" | sed 's/^/     /'
                    if [ "$fresh" = "1" ]; then
                        echo ""
                        echo "   A mark exists but does NOT cover:"
                        printf '%s\n' "$unapproved" | sed 's/^/     /'
                    fi
                    echo ""
                    echo "   A branch from a stale base wipes out other people's work silently —"
                    echo "   the fast-forward goes through normally. First git fetch and check the diff."
                    echo ""
                    echo "   If the deletion is intentional, confirm it by name:"
                    echo "     scripts/git-allow-delete.sh add <path…>"
                    echo ""
                    exit 1
                fi

                rm -f "$ALLOWDEL"
                echo "⚪️ Deletion confirmed by a mark; the mark is now consumed:"
                echo "$dels" | sed 's/^/     /'
            fi
        fi ;;
    esac

    [ "$local_sha" = "$(git rev-parse HEAD)" ] && pushing_head=1
done <<REFS_EOF
$REFS
REFS_EOF

[ "$pushed_any" = "0" ] && exit 0

if [ "$pushing_head" = "0" ]; then
  echo ""
  echo "🔴 The commit being pushed is NOT HEAD."
  echo ""
  echo "   Types can only be checked for the state that is in the working tree."
  echo "   Pushing a different commit, the hook would check something other than"
  echo "   what ships, and its \"ok\" would be a lie."
  echo ""
  echo "   Switch to the commit you want, or push with --no-verify,"
  echo "   knowing that nobody will check the types."
  echo ""
  exit 1
fi

# ─── 2. The working tree must match what is shipping ────────────────────────
# tsc checks the files on disk, not the commit's content. With a dirty tree a
# green check says nothing about the code being pushed: an uncommitted change
# easily "fixes" a type that is broken in the commit itself.
dirty=$(git status --porcelain -- \
  '*.ts' '*.tsx' '*.mts' '*.cts' \
  'tsconfig*.json' 'next.config.*' 'package.json' 2>/dev/null)

if [ -n "$dirty" ]; then
  echo ""
  echo "🔴 The working tree has uncommitted code changes:"
  echo ""
  echo "$dirty" | sed 's/^/     /'
  echo ""
  echo "   The type check looks at files on disk, so its result would apply"
  echo "   to the tree, not to the commit being pushed."
  echo ""
  echo "   Commit the changes or stash them: git stash -u"
  echo ""
  exit 1
fi

# ─── 3. Build artifacts without which the type check is blind ───────────────
# For Next these are .next/types and .next/dev/types: tsconfig.include pulls them in
# to check App Router conventions (page/route/layout signatures, params as a
# Promise, generateMetadata). Their absence is NOT an error for tsc — it silently
# checks less and still says "ok". That is exactly what must be caught.
#
# 🔴 A project without such generation keeps GG_REQUIRE_DEV_READY=0 — then the
# block is skipped entirely. Do not put a nonexistent path here: push would
# become impossible, and the cause would look like a broken hook.
ready=""
if [ "$GG_REQUIRE_DEV_READY" = "1" ] && [ -n "$GG_DEV_READY_GLOBS" ]; then
  ready=$(find $GG_DEV_READY_GLOBS -name '*.ts' 2>/dev/null | wc -l | tr -d ' ')
  if [ "$ready" = "0" ]; then
    echo ""
    echo "🔴 No generated types ($GG_DEV_READY_GLOBS)."
    echo ""
    echo "   Without them the check passes green but does NOT look at page and"
    echo "   route signatures — exactly the errors that break the runtime."
    echo ""
    if [ -n "$GG_DEV_CMD" ]; then
      echo "   Run at least once:  $GG_DEV_CMD"
    else
      echo "   Run the dev server or a build to generate them."
    fi
    echo ""
    exit 1
  fi
fi

# ─── 4. The check itself ────────────────────────────────────────────────────
# 🔴 An empty GG_TYPECHECK_CMD means "this project has no types" — a deliberate
# decision of whoever installed it, not a breakage. Say so out loud: silence here
# is indistinguishable from "the check passed".
if [ -z "$GG_TYPECHECK_CMD" ]; then
  echo "⚪️ Type check not configured (GG_TYPECHECK_CMD is empty in .gitguards.conf)."
else
  if [ -n "$ready" ]; then
    echo "🔍 Type check ($ready generated type files)…"
  else
    echo "🔍 Type check…"
  fi
  sh -c "$GG_TYPECHECK_CMD"
fi
