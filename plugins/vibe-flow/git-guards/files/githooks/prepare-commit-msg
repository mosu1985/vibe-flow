#!/usr/bin/env sh
# CANONICAL prepare-commit-msg. Installed by scripts/install-git-guards.sh into
# $GIT_COMMON_DIR/monitorex-hooks next to pre-push.
#
# PURPOSE: stamp `Session-Id: <actor>` on commits that git itself creates —
# `git merge` (with or without conflicts), `git commit --no-edit` under
# MERGE_HEAD, `git commit` / `--amend -m` in a worktree. Before this hook only
# git-safe-commit.sh wrote the trailer, so the documented way of updating a
# lagging branch (merge origin/<protected>, resolve, `git commit --no-edit`)
# ALWAYS produced a commit that pre-push called someone else's work, and the
# push needed a human allowlist mark (11.11.2026, wt/dev-listener, d61b4253).
#
# 🔴 An existing Session-Id is NEVER replaced (`--if-exists doNothing`):
# cherry-pick or amend of a neighbor's commit keeps the neighbor's id and stays
# "foreign" for pre-push — that is the barrier working, not a gap.
# No actor (a human without MONITOREX_ACTOR) → the message is left untouched.
# Any failure here must not block the commit: the worst case is the old
# behavior (pre-push asks for an allowlist mark).
MSG="$1"
ACTOR="${CLAUDE_CODE_SESSION_ID:-${MONITOREX_ACTOR:-}}"
[ -n "$ACTOR" ] || exit 0
[ -f "$MSG" ] || exit 0

git interpret-trailers --in-place --if-exists doNothing \
    --trailer "Session-Id: $ACTOR" "$MSG" 2>/dev/null || true
exit 0
